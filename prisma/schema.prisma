generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      String   @default("VIEWER") // OWNER | MANAGER | VIEWER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SushiOrder {
  id               String           @id @default(cuid())
  ossId            String           @unique
  poNumber         String
  supplierName     String
  status           Int              // 1=待下单 2=已下单 3=已确认
  poDate           String?
  deliveryDate     String?
  orderDate        String?
  weekNo           Int?
  year             Int?
  syncedAt         DateTime         @default(now())
  inventoryApplied Boolean          @default(false)
  items            SushiOrderItem[]
}

model SushiOrderItem {
  id        String     @id @default(cuid())
  orderId   String
  order     SushiOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ossItemId String
  itemCode  String
  itemName  String
  uom       String
  quantity  Float
}

model SushiInventoryItem {
  id        String   @id @default(cuid())
  name      String
  quantity  Float    @default(0)
  unit      String   @default("")
  notes     String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  username  String
  action    String
  detail    String?
  createdAt DateTime @default(now())
}

model TrainingStaff {
  id          String   @id @default(cuid())
  name        String
  position    String   @default("Sushi Staff")
  store       String   @default("")
  trainerName String   @default("")
  startDate   String
  notes       String?
  createdAt   DateTime @default(now())

  records   TrainingRecord[]
  checklist TrainingChecklist[]
}

model TrainingRecord {
  id                  String   @id @default(cuid())
  staffId             String
  taskKey             String   @default("")
  date                String
  type                String
  areaForImprovement  String
  feedbackActionTaken String
  followUpNeeded      String
  createdByUsername   String   @default("")
  createdByRole       String   @default("")
  createdAt           DateTime @default(now())

  staff TrainingStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model WeeklyReport {
  id                  String   @id @default(cuid())
  title               String   @default("Weekly Manager Report: 1% Project")
  weekFrom            String
  weekTo              String
  storeName           String   @default("")
  managerName         String   @default("")
  lastWeekAchievement String   @default("")
  focusPoint          String   @default("")
  actionPlan          String   @default("")
  peopleFocus         String   @default("")
  createdBy           String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model TrainingChecklist {
  id          String @id @default(cuid())
  staffId     String
  taskKey     String
  status      String @default("") // "pass" | "partial" | "fail" | ""
  completedAt String @default("")
  trainerName String @default("")

  staff TrainingStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, taskKey])
}

model VegeInventoryItem {
  id        String   @id @default(cuid())
  name      String
  quantity  Float    @default(0)
  unit      String   @default("")
  notes     String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model PackagingInventoryItem {
  id        String   @id @default(cuid())
  name      String
  quantity  Float    @default(0)
  unit      String   @default("")
  notes     String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model FrozenInventoryItem {
  id        String   @id @default(cuid())
  name      String
  quantity  Float    @default(0)
  unit      String   @default("")
  notes     String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model DrinkInventoryItem {
  id        String   @id @default(cuid())
  name      String
  quantity  Float    @default(0)
  unit      String   @default("")
  notes     String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Roster {
  id        String       @id @default(cuid())
  weekStart String       // "YYYY-MM-DD" — the Monday of the week
  storeName String       @default("")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  staff     RosterStaff[]
}

model RosterStaff {
  id       String        @id @default(cuid())
  rosterId String
  name     String
  order    Int           @default(0)
  adjHours Float         @default(0)
  roster   Roster        @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  shifts   RosterShift[]
}

model RosterShift {
  id      String      @id @default(cuid())
  staffId String
  date    String      // "YYYY-MM-DD"
  inTime  String      @default("")
  outTime String      @default("")
  code    String      @default("")
  staff   RosterStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
}
